{
  "manifest_version": 3,
  "name": "CareerOS — CV for this vacancy",
  "short_name": "CareerOS",
  "version": "0.1.0",
  "description": "Match your CV to the vacancy you are looking at on Djinni, DOU or Work.ua: score, missing skills, an honest CV rewrite and a cover letter.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "CareerOS: tailor your CV to this vacancy",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["sidePanel", "scripting", "storage"],
  "host_permissions": [
    "https://djinni.co/*",
    "https://jobs.dou.ua/*",
    "https://www.work.ua/*",
    "https://work.ua/*"
  ]
}
